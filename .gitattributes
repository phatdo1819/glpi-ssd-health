# Keep these byte-for-byte on every system: git apply needs the exact patch,
# and drivedb.h must match the checksum of the official smartmontools file
*.patch     -text
drivedb.h   -text
*.exe       binary
*.png       binary

# Linux runs these: keep LF line endings even when checked out on Windows
*.sh        text eol=lf
*.pm        text eol=lf
